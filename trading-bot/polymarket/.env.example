# ─── Polymarket Credentials ───────────────────────────────────────────────
# Get these from: polymarket.com → Settings → API
POLY_PRIVATE_KEY=0x_your_wallet_private_key_here
POLY_API_KEY=your_api_key
POLY_API_SECRET=your_api_secret
POLY_API_PASSPHRASE=your_passphrase

# ─── Trading Mode ─────────────────────────────────────────────────────────
# PAPER_TRADING=true   → no real money (default, safe to test)
# PAPER_TRADING=false  → LIVE trading (requires funded wallet)
PAPER_TRADING=true

# ─── Strategy Parameters (optional overrides) ─────────────────────────────
MIN_EDGE_THRESHOLD=0.08
KELLY_FRACTION=0.25
MAX_POSITION_USDC=500
DAILY_LOSS_LIMIT_USDC=200
